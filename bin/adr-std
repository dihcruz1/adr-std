#!/usr/bin/env bash
# adr-std — instala, atualiza e gerencia a skill adr-std nos agentes de código.
# https://github.com/dihcruz1/adr-std

set -u

# --- locais -----------------------------------------------------------------

self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/adr-std"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/adr-std"
STATE_FILE="$CONFIG_DIR/state"
BIN_DIR="$HOME/.local/bin"
SHARED_DIR=".agents/skills"
SKILL_NAME="adr-std"
MARKER=".installed-by-adr-std"

# Fonte: ADR_STD_SOURCE, o repositório (bin/..) ou a cópia instalada.
if [ -n "${ADR_STD_SOURCE:-}" ]; then
  SRC="$ADR_STD_SOURCE"
elif [ -f "$self_dir/../agents.tsv" ]; then
  SRC="$(cd "$self_dir/.." && pwd)"
else
  SRC="$DATA_DIR"
fi

# --- utilitários ------------------------------------------------------------

err() { echo "adr-std: $*" >&2; }
die() { local code="$1"; shift; err "$*"; exit "$code"; }

version() { cat "$SRC/VERSION" 2>/dev/null || echo "desconhecida"; }

# Imprime as linhas de agents.tsv: id<TAB>nome<TAB>detecta<TAB>pasta<TAB>compartilhada
agent_rows() {
  [ -f "$SRC/agents.tsv" ] || die 1 "agents.tsv não encontrado em $SRC"
  grep -v '^#' "$SRC/agents.tsv" | grep .
}

agent_ids() { agent_rows | cut -f1; }

agent_field() { # id campo(2..5)
  agent_rows | awk -F'\t' -v id="$1" -v f="$2" '$1 == id { print $f }'
}

is_agent() { agent_ids | grep -qxF -- "$1"; }

is_detected() { [ -d "$HOME/$(agent_field "$1" 3)" ]; }

detected_ids() {
  local id
  for id in $(agent_ids); do is_detected "$id" && echo "$id"; done
}

# Imprime as linhas de commands.tsv: acao<TAB>descricao-curta
command_rows() {
  [ -f "$SRC/commands.tsv" ] || return 1
  grep -v '^#' "$SRC/commands.tsv" | grep .
}

# Imprime as linhas de command_targets.tsv: id<TAB>pasta<TAB>extensao<TAB>variavel-argumento
cmd_target_rows() {
  [ -f "$SRC/command_targets.tsv" ] || return 1
  grep -v '^#' "$SRC/command_targets.tsv" | grep .
}

has_command_target() { cmd_target_rows | cut -f1 | grep -qxF -- "$1"; }

cmd_target_field() { # id campo(2..4)
  cmd_target_rows | awk -F'\t' -v id="$1" -v f="$2" '$1 == id { print $f }'
}

command_marker_line() { # extensao
  case "$1" in
    toml) echo '# adr-std: gerado automaticamente; não editar à mão' ;;
    *)    echo '<!-- adr-std: gerado automaticamente; não editar à mão -->' ;;
  esac
}

command_owned_by_us() { # arquivo
  [ -f "$1" ] && grep -qF 'adr-std: gerado automaticamente' "$1"
}

command_file_content() { # acao descricao extensao variavel-argumento
  local action="$1" desc="$2" ext="$3" argvar="$4" marker
  marker="$(command_marker_line "$ext")"
  case "$ext" in
    toml)
      printf '%s\ndescription = "%s"\nprompt = """\nUse a skill adr-std, ação "%s", com estes argumentos: %s\n"""\n' \
        "$marker" "$desc" "$action" "$argvar"
      ;;
    prompt)
      printf -- '---\nname: adr-std-%s\ndescription: %s\n---\n%s\nUse a skill adr-std, ação "%s", com estes argumentos: %s\n' \
        "$action" "$desc" "$marker" "$action" "$argvar"
      ;;
    *)
      printf -- '---\ndescription: %s\n---\n%s\nUse a skill adr-std, ação "%s", com estes argumentos: %s\n' \
        "$desc" "$marker" "$action" "$argvar"
      ;;
  esac
}

suggest_agent() { # termo → id parecido (ou vazio)
  local term="$1" id
  for id in $(agent_ids); do
    case "$id" in "$term"*|*"$term"*) echo "$id"; return ;; esac
  done
}

# Pasta onde a skill fica para o agente (compartilhada quando o agente a lê).
target_for() {
  local id="$1"
  if [ "$id" = "universal" ] || [ "$(agent_field "$id" 5)" = "sim" ]; then
    echo "$HOME/$SHARED_DIR/$SKILL_NAME"
  else
    echo "$HOME/$(agent_field "$id" 4)/$SKILL_NAME"
  fi
}

# --- estado -----------------------------------------------------------------
# Linhas: version<TAB>X · mode<TAB>copy|link · agent<TAB>id<TAB>pasta · path_line<TAB>arquivo

state_lines() { [ -f "$STATE_FILE" ] && cat "$STATE_FILE"; return 0; }

state_get() { state_lines | awk -F'\t' -v k="$1" '$1 == k { print $2; exit }'; }

state_agents() { state_lines | awk -F'\t' '$1 == "agent" { print $2 "\t" $3 }'; }

state_put() { # chave valor — substitui a linha da chave
  mkdir -p "$CONFIG_DIR"
  { state_lines | awk -F'\t' -v k="$1" '$1 != k'; printf '%s\t%s\n' "$1" "$2"; } > "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

state_add_agent() { # id pasta
  mkdir -p "$CONFIG_DIR"
  { state_lines | awk -F'\t' -v id="$1" '!($1 == "agent" && $2 == id)'; printf 'agent\t%s\t%s\n' "$1" "$2"; } > "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

state_add_command() { # id arquivo
  mkdir -p "$CONFIG_DIR"
  { state_lines | awk -F'\t' -v id="$1" -v p="$2" '!($1 == "command" && $2 == id && $3 == p)'; printf 'command\t%s\t%s\n' "$1" "$2"; } > "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

# Remove do disco (se ainda marcados) e do estado todos os arquivos de comando registrados para o agente.
state_del_commands_for() { # id
  local id="$1" path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    command_owned_by_us "$path" && rm -f "$path"
  done < <(state_lines | awk -F'\t' -v id="$id" '$1 == "command" && $2 == id { print $3 }')
  [ -f "$STATE_FILE" ] || return 0
  awk -F'\t' -v id="$id" '!($1 == "command" && $2 == id)' "$STATE_FILE" > "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

# --- argumentos -------------------------------------------------------------

AGENTS=()
ALL=0
LINK=0
DRY=0
NO_COMMANDS=0
REQ_VERSION=""

parse_args() {
  local tok part
  while [ $# -gt 0 ]; do
    tok="$1"; shift
    case "$tok" in
      --agent)   ;; # os nomes seguintes são agentes
      --agent=*) set -- "${tok#--agent=}" "$@" ;;
      --all)     ALL=1 ;;
      --link)    LINK=1 ;;
      --dry-run) DRY=1 ;;
      --no-commands) NO_COMMANDS=1 ;;
      --version) REQ_VERSION="${1:-}"; [ $# -gt 0 ] && shift ;;
      --*)       die 2 "opção desconhecida: $tok" ;;
      *)
        for part in ${tok//,/ }; do
          if is_agent "$part"; then
            AGENTS+=("$part")
          else
            local s; s="$(suggest_agent "$part")"
            [ -n "$s" ] && die 2 "agente desconhecido: $part (quis dizer $s?)"
            die 2 "agente desconhecido: $part. Veja: adr-std agents"
          fi
        done ;;
    esac
  done
}

# --- instalação -------------------------------------------------------------

# A pasta foi instalada por este comando? (registrada no estado E com marcador ou link para a fonte)
owned_by_us() {
  local dest="$1"
  state_agents | cut -f2 | grep -qxF -- "$dest" || return 1
  if [ -L "$dest" ]; then
    [ "$(readlink "$dest")" = "$SRC/skill" ] || [ "$(readlink "$dest")" = "$DATA_DIR/skill" ]
  else
    [ -f "$dest/$MARKER" ]
  fi
}

install_to() { # pasta de destino
  local dest="$1" tmp
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    if owned_by_us "$dest"; then
      rm -rf "$dest"
    else
      err "$dest já existe e não foi instalada pelo adr-std; nada foi alterado. Remova ou renomeie a pasta e tente de novo."
      return 4
    fi
  fi
  mkdir -p "$(dirname "$dest")"
  if [ "$LINK" -eq 1 ]; then
    ln -s "$SRC/skill" "$dest"
  else
    tmp="$dest.tmp.$$"
    cp -R "$SRC/skill" "$tmp"
    printf 'adr-std %s instalado em %s\n' "$(version)" "$(date +%Y-%m-%d)" > "$tmp/$MARKER"
    mv "$tmp" "$dest"
  fi
  echo "  ✔ adr-std $(version) → $dest"
}

# Menu de escolha. Lê de /dev/tty (funciona também em "curl | bash").
# ADR_STD_TTY troca a origem da resposta (usado nos testes).
choose_agents() {
  local tty="${ADR_STD_TTY:-/dev/tty}" line tok i
  local -a found
  mapfile -t found < <(detected_ids)
  [ ${#found[@]} -gt 0 ] || die 3 "nenhum agente encontrado neste computador. Indique com --agent (veja: adr-std agents)"
  if ! { exec 3<"$tty"; } 2>/dev/null; then
    die 3 "sem terminal para o menu. Indique os agentes com --agent (ex.: --agent claude-code) ou use --all"
  fi
  echo "Agentes encontrados neste computador:"
  for i in "${!found[@]}"; do
    printf '  %d) %-15s ~/%s\n' "$((i + 1))" "${found[$i]}" "$(agent_field "${found[$i]}" 4)"
  done
  printf 'Em quais instalar? (ex.: 1 3, ou "todos"): '
  IFS= read -r line <&3 || line=""
  exec 3<&-
  echo
  if [ "$line" = "todos" ]; then
    AGENTS=("${found[@]}")
    return
  fi
  for tok in ${line//,/ }; do
    if [[ "$tok" =~ ^[0-9]+$ ]] && [ "$tok" -ge 1 ] && [ "$tok" -le ${#found[@]} ]; then
      AGENTS+=("${found[$((tok - 1))]}")
    else
      die 2 "escolha inválida: $tok"
    fi
  done
  [ ${#AGENTS[@]} -gt 0 ] || die 3 "nenhum agente escolhido"
}

install_commands() { # instala os arquivos de comando de ação para os AGENTS selecionados
  [ "$NO_COMMANDS" -eq 1 ] && return 0
  command_rows >/dev/null 2>&1 || return 0
  local id dest_dir ext argvar action desc file
  for id in "${AGENTS[@]}"; do
    has_command_target "$id" || continue
    dest_dir="$HOME/$(cmd_target_field "$id" 2)"
    ext="$(cmd_target_field "$id" 3)"
    argvar="$(cmd_target_field "$id" 4)"
    [ "$DRY" -eq 1 ] || mkdir -p "$dest_dir"
    while IFS=$'\t' read -r action desc; do
      file="$dest_dir/adr-std-$action.$ext"
      if [ -e "$file" ] && ! command_owned_by_us "$file"; then
        echo "  ! $file já existe e não foi gerado pelo adr-std; mantido"
        continue
      fi
      if [ "$DRY" -eq 1 ]; then
        echo "  (simulação) criaria $file"
        continue
      fi
      command_file_content "$action" "$desc" "$ext" "$argvar" > "$file"
      state_add_command "$id" "$file"
    done < <(command_rows)
  done
}

cmd_install() {
  parse_args "$@"
  [ -f "$SRC/skill/SKILL.md" ] || die 1 "skill não encontrada em $SRC/skill"
  if [ "$ALL" -eq 1 ]; then
    mapfile -t AGENTS < <(detected_ids)
    [ ${#AGENTS[@]} -gt 0 ] || die 3 "nenhum agente encontrado neste computador. Veja: adr-std agents"
  fi
  [ ${#AGENTS[@]} -gt 0 ] || choose_agents

  local id dest
  local -A done_targets=()
  for id in "${AGENTS[@]}"; do
    dest="$(target_for "$id")"
    is_detected "$id" || echo "  ! $id não foi encontrado neste computador; instalando mesmo assim"
    if [ -z "${done_targets[$dest]:-}" ]; then
      done_targets[$dest]=1
      if [ "$DRY" -eq 1 ]; then
        echo "  (simulação) instalaria adr-std $(version) em $dest"
      else
        install_to "$dest" || return $?
      fi
    fi
    [ "$DRY" -eq 1 ] || state_add_agent "$id" "$dest"
  done
  install_commands
  if [ "$DRY" -eq 0 ]; then
    state_put version "$(version)"
    state_put mode "$([ "$LINK" -eq 1 ] && echo link || echo copy)"
    echo "Pronto. Abra uma nova sessão do agente para carregar a skill."
  fi
}

state_del_agent() { # id
  [ -f "$STATE_FILE" ] || return 0
  awk -F'\t' -v id="$1" '!($1 == "agent" && $2 == id)' "$STATE_FILE" > "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

# Há outro agente registrado usando a mesma pasta?
dest_in_use_by_other() { # pasta id
  state_agents | awk -F'\t' -v d="$1" -v id="$2" '$2 == d && $1 != id { found = 1 } END { exit !found }'
}

cmd_uninstall() {
  parse_args "$@"
  local id dest
  if [ ${#AGENTS[@]} -eq 0 ]; then
    mapfile -t AGENTS < <(state_agents | cut -f1)
  fi
  [ ${#AGENTS[@]} -gt 0 ] || { echo "Nada a remover: nenhum agente registrado."; return 0; }
  for id in "${AGENTS[@]}"; do
    dest="$(state_agents | awk -F'\t' -v id="$id" '$1 == id { print $2 }')"
    if [ -z "$dest" ]; then
      echo "  • $id não está registrado; nada a remover"
      continue
    fi
    if dest_in_use_by_other "$dest" "$id"; then
      echo "  • $dest continua em uso por outro agente; mantida"
    elif [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
      echo "  • $dest já não existe"
    elif owned_by_us "$dest"; then
      if [ "$DRY" -eq 1 ]; then echo "  (simulação) removeria $dest"; else rm -rf "$dest"; echo "  ✔ removida $dest"; fi
    else
      echo "  ! $dest não foi instalada pelo adr-std; mantida"
    fi
    [ "$DRY" -eq 1 ] || { state_del_agent "$id"; state_del_commands_for "$id"; }
  done
}

# Atualiza: baixa a release (última ou --version), confere o checksum e reinstala nos agentes registrados.
cmd_update() {
  parse_args "$@"
  local -a ids=()
  mapfile -t ids < <(state_agents | cut -f1)
  local id
  for id in "${AGENTS[@]+"${AGENTS[@]}"}"; do
    printf '%s\n' "${ids[@]+"${ids[@]}"}" | grep -qxF -- "$id" || ids+=("$id")
  done
  [ ${#ids[@]} -gt 0 ] || die 3 "nenhum agente registrado. Instale primeiro com: adr-std install"
  local installer="$DATA_DIR/install.sh"
  [ -f "$installer" ] || installer="$SRC/install.sh"
  [ -f "$installer" ] || die 1 "instalador não encontrado; reinstale o adr-std"
  local -a opts=()
  [ -n "$REQ_VERSION" ] && opts+=(--version "$REQ_VERSION")
  [ "$LINK" -eq 1 ] && opts+=(--link)
  if [ "$DRY" -eq 1 ]; then
    echo "  (simulação) atualizaria ${REQ_VERSION:-para a última versão} nos agentes: ${ids[*]}"
    return 0
  fi
  ADR_STD_REMOTE=1 bash "$installer" "${opts[@]+"${opts[@]}"}" --agent "${ids[@]}"
}

cmd_self_uninstall() {
  parse_args "$@"
  local profile
  profile="$(state_get path_line)"
  if [ "$DRY" -eq 1 ]; then
    echo "  (simulação) removeria a skill dos agentes registrados, $BIN_DIR/adr-std, $DATA_DIR e $CONFIG_DIR"
    [ -n "$profile" ] && echo "  (simulação) removeria a linha '# adr-std' de $profile"
    return 0
  fi
  AGENTS=()
  cmd_uninstall
  if [ -n "$profile" ] && [ -f "$profile" ]; then
    grep -vF "# adr-std" "$profile" > "$profile.tmp" || true
    mv "$profile.tmp" "$profile"
    echo "  ✔ linha do PATH removida de $profile"
  fi
  rm -rf "$CONFIG_DIR" "$DATA_DIR"
  rm -f "$BIN_DIR/adr-std"
  echo "adr-std removido deste computador."
}

cmd_status() {
  local ver; ver="$(state_get version)"
  if [ -z "$ver" ] || [ -z "$(state_agents)" ]; then
    echo "adr-std: skill não instalada (comando $(version)). Instale com: adr-std install"
    return 0
  fi
  echo "adr-std: skill instalada na versão $ver (comando $(version)); modo $(state_get mode)"
  local id dest note
  while IFS=$'\t' read -r id dest; do
    if [ -L "$dest" ] || [ -f "$dest/SKILL.md" ]; then note="íntegra"; else note="danificada (pasta ausente ou incompleta)"; fi
    printf '  %-15s %s  [%s]\n' "$id" "$dest" "$note"
  done < <(state_agents)
}

cmd_check() {
  [ $# -gt 0 ] || die 2 "uso: adr-std check <arquivo-ou-pasta> [--name-pattern REGEX]"
  local py=""
  if command -v python3 >/dev/null 2>&1; then py=python3
  elif command -v python >/dev/null 2>&1 && python -c 'import sys; sys.exit(sys.version_info[0] < 3)' 2>/dev/null; then py=python
  fi
  [ -n "$py" ] || die 6 "o comando check precisa de Python 3, que não foi encontrado. Instale o Python 3 ou aplique o checklist manualmente: $SRC/skill/references/checklist.md"
  local script="$SRC/skill/scripts/check_adr.py"
  [ -f "$script" ] || die 1 "check_adr.py não encontrado em $SRC/skill/scripts"
  "$py" "$script" "$@"
}

# --- comandos ---------------------------------------------------------------

cmd_version() { echo "adr-std $(version)"; }

cmd_help() {
  cat <<EOF
adr-std $(version) — gerencia a skill adr-std (ADRs segundo a ISO/IEC/IEEE 42010:2022)

Uso: adr-std <comando> [opções]

Comandos:
  install [agentes...]   Instala a skill (sem agentes: mostra um menu)
      --agent a b        Agentes (separados por espaço ou vírgula); também aceita os nomes direto
      --all              Todos os agentes encontrados
      --link             Link para a fonte em vez de cópia (desenvolvimento)
      --dry-run          Mostra o que faria, sem alterar nada
      --version vX.Y.Z   Versão específica
  update                 Atualiza nos agentes já registrados (--agent inclui mais agentes)
  uninstall [agentes...] Remove a skill (sem agentes: de todos)
  self-uninstall         Remove tudo, inclusive este comando
  status                 Versão, agentes, integridade e se há versão nova
  agents                 Agentes suportados e os encontrados neste computador
  check <arquivo|pasta>  Verifica ADRs (precisa de Python 3)
  version                Mostra a versão
  help                   Mostra esta ajuda

Agentes: $(agent_ids | tr '\n' ' ')
EOF
}

cmd_agents() {
  printf '  %-15s %-27s %-30s %s\n' "AGENTE" "NOME" "PASTA DE SKILLS" "NESTE COMPUTADOR"
  local id name dir
  while IFS=$'\t' read -r id name _ dir _; do
    local mark="-"
    is_detected "$id" && mark="✔ encontrado"
    # shellcheck disable=SC2088 # "~/..." é texto exibido ao usuário, não um caminho expandido
    printf '  %-15s %-27s %-30s %s\n' "$id" "$name" "~/${dir}" "$mark"
  done < <(agent_rows)
}

# --- despacho ---------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    version|--version|-v) cmd_version ;;
    help|--help|-h)       cmd_help ;;
    agents)               cmd_agents ;;
    install)              cmd_install "$@" ;;
    uninstall)            cmd_uninstall "$@" ;;
    status)               cmd_status ;;
    check)                cmd_check "$@" ;;
    self-uninstall)       cmd_self_uninstall "$@" ;;
    update)               cmd_update "$@" ;;
    *) err "comando desconhecido: $cmd"; echo; cmd_help; exit 2 ;;
  esac
}

main "$@"
